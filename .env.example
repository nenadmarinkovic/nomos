MISTRAL_API_KEY=

# Optional: override the narration model (defaults to mistral-small-latest).
# MISTRAL_MODEL=mistral-small-latest

# Optional: /api/observe spend limits. Each narration is one Mistral call, and
# the endpoint is open to signed-out visitors, so it is metered per caller
# (signed-in by user id, otherwise by IP) and again deployment-wide. The window
# lives in Postgres, so these are true ceilings across every instance rather
# than per-process. Defaults below; a tab narrating flat out uses ~5/min and
# ~300/hour.
# OBSERVE_LIMIT_ANON_PER_MIN=12
# OBSERVE_LIMIT_ANON_PER_HOUR=400
# OBSERVE_LIMIT_USER_PER_MIN=20
# OBSERVE_LIMIT_USER_PER_HOUR=800
# OBSERVE_LIMIT_GLOBAL_PER_HOUR=3000

# Optional: /api/runs write, read and claim ceilings. Defaults below.
# RUNS_WRITE_PER_MIN=20
# RUNS_WRITE_PER_HOUR=200
# RUNS_READ_PER_MIN=120
# RUNS_CLAIM_PER_MIN=10
# RUNS_CLAIM_PER_HOUR=60

# ---------------------------------------------------------------------------
# Identifying the caller behind a proxy
# ---------------------------------------------------------------------------
# Rate limiting anonymous callers needs a client IP, and the only source is a
# forwarding header — which the client can also set. `X-Forwarded-For` is
# appended to by each hop, so the entries our own infrastructure wrote are the
# ones on the RIGHT; anything the client invented sits on the left and must be
# ignored. Set this to the number of proxies between the internet and the app
# so the right entry is picked: 1 for a single load balancer (Vercel, Fly, a
# lone nginx), 2 for Cloudflare in front of one of those.
# TRUSTED_PROXY_HOPS=1
#
# Alternatively, name a single-value header your platform guarantees to
# overwrite, and it is read verbatim instead (hop counting does not apply).
# TRUSTED_IP_HEADER=cf-connecting-ip

DATABASE_URL=postgresql://nomos:nomos@localhost:5434/nomos

# Better Auth — secret used to sign sessions. Generate with:
#   openssl rand -base64 32
# Use a different value in production than in development.
BETTER_AUTH_SECRET=

# Public origin Better Auth uses for cookies / redirects. In production this
# must be the https origin: it is the origin the auth endpoints check requests
# against.
BETTER_AUTH_URL=http://localhost:3000

# Optional: extra origins allowed to drive the auth endpoints (comma
# separated), for preview deployments or a second domain. BETTER_AUTH_URL is
# always trusted and does not need repeating here.
# BETTER_AUTH_TRUSTED_ORIGINS=https://preview.example.com

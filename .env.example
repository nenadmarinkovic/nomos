# Copy to .env and fill in as needed:  cp .env.example .env
# `.env` (not `.env.local`) is used so the Prisma CLI and Next.js read the
# same file.

# Mistral API — powers the AI observers' per-event narration.
# Without it the simulation runs fine; observers simply stay silent.
# Get a key at https://console.mistral.ai/
MISTRAL_API_KEY=

# Optional: override the narration model (defaults to mistral-small-latest).
# MISTRAL_MODEL=mistral-small-latest

# Postgres — saved runs, user accounts, chronicle persistence.
# The default matches docker-compose.yml (`docker compose up -d postgres`),
# which publishes the container on host port 5434.
DATABASE_URL=postgresql://nomos:nomos@localhost:5434/nomos

# Better Auth — secret used to sign sessions. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public origin Better Auth uses for cookies / redirects.
BETTER_AUTH_URL=http://localhost:3000
